# Frontend env for `npm run dev`.  cp .env.local.example .env.local  and fill in.
# .env.local is gitignored. Everything here ships in the browser bundle — never put secrets here.

# Main NestJS API (no trailing slash; paths start with /api/...)
VITE_API_URL=http://localhost:3000
# Optional separate AI service for chat / explain / brief / alert generation (defaults to VITE_API_URL)
VITE_AGENT_API_URL=

# true -> in-browser mock API (MSW); no backend needed
VITE_MOCK=false

# Optional real auth. Blank -> demo mode: the app sends an `x-dev-role` header per workspace
# (the backend must run with AUTH_DEV_BYPASS=true).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map needs no key: MapLibre + Carto (streets) / Esri World Imagery (satellite) tiles.
