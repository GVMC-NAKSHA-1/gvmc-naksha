# ── Quick start (zero keys) ───────────────────────────────────────────────────
#   cp .env.example .env
#   docker compose up --build
#   (in another shell)  cd frontend && npm install && npm run dev
#   open http://localhost:3001  ->  pick a workspace  ->  done
#
# Postgres+PostGIS, Redis, DB migrations and auth-bypass all work with NO external
# accounts. Fill in the sections below only to switch on the real thing.
# Commit only .env.example.
# ──────────────────────────────────────────────────────────────────────────────

# ── Local infra — leave blank to use the bundled containers ───────────────────
DATABASE_URL=
REDIS_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# true  -> no Supabase needed; the API runs open, role comes from the login screen.
# false -> real Supabase Auth (fill SUPABASE_* below).
AUTH_DEV_BYPASS=true
# Where role/ward_scope live when AUTH_DEV_BYPASS=false: 'local' (self-provisioned in
# the bundled Postgres; first user becomes admin) or 'supabase'.
PROFILES_SOURCE=local
# supabase.com -> project -> Settings -> API   (only needed when AUTH_DEV_BYPASS=false)
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Object storage: Cloudflare R2 ────────────────────────────────────────────
# Needed to actually upload source files and export the cadastre. Everything else
# (matching, conflicts, golden-record assembly, GeoJSON build) works without it.
# Cloudflare dashboard -> R2 -> create a bucket + an API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: point at any S3-compatible store (MinIO / LocalStack) instead of R2.
# docker compose uses the bundled MinIO automatically when these are blank.
R2_ENDPOINT=
# Browser-reachable endpoint used for presigned URLs (e.g. http://localhost:9000 for local MinIO).
R2_PUBLIC_ENDPOINT=

# ── AI: Groq (optional) ─────────────────────────────────────────────────────
# console.groq.com/keys. Blank -> chat/explain/brief/alert return templated text
# and schema-mapping uses deterministic column-name matching.
GROQ_API_KEY=
# Model id on Groq (they retire models over time). Blank -> openai/gpt-oss-120b.
GROQ_MODEL=

# ── GeoAI feature extraction (optional) ─────────────────────────────────────
# Path (inside the worker container) to an ONNX building-segmentation model. Blank -> the
# worker uses nDSM (DSM/DTM rasters) or classical vision for RGB imagery.
FOOTPRINT_MODEL_PATH=

# ── Map ───────────────────────────────────────────────────────────────────────
# The frontend uses MapLibre GL with free OSM / Esri tiles — no key needed.

# ── URLs / CORS — fine as-is for local dev ──────────────────────────────────
VITE_API_URL=http://localhost:3000
API_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3001

# ── Deploy-only (unused for local dev) ─────────────────────────────────────
RESEND_API_KEY=
# Brevo powers HIGH-severity ward-alert and ticket-review emails (see key.md §7). Needs a
# verified sender — Brevo dashboard -> Senders, Domains & Dedicated IPs -> Senders. Blank
# BREVO_SENDER_EMAIL -> those emails are skipped (logged, non-fatal).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GVMC Naksha
WAZUH_HOST=
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_SSH_KEY=
